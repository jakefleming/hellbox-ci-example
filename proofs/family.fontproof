erSpacings": [], "waterfallFixedColumnWidth": 480, "waterfallShowSizeLabels": true, "waterfallSizes": [8, 12, 18, 24, 32, 48, 72, 96], "waterfallTextOrientation": "horizontal", "wordWrap": true}, "461C7AE5-5F73-4BA7-B90D-7CD929EDF06E": {"autoStyleSeed": 0, "availableFeatures": [], "axesValues": {}, "basicTextOrientation": "horizontal", "cases": [], "caseScope": "latin-only", "cellMerges": [], "centerOnPage": false, "columnCount": 2, "columnGap": 20, "columnsMode": "continuous", "columnsTextOrientation": "horizontal", "comparisonLayout": "rows", "contentFlow": "continuous", "customFeatureNames": [], "disabledFonts": [], "enableInlineStyling": false, "fitToPage": false, "fontFeatures": {}, "fontSize": 54, "fontSizes": [], "forceUprightInVertical": false, "glyphGridCombineStyles": false, "glyphGridGroupAlternates": false, "glyphGridHideEmptyGlyphs": true, "glyphGridMetricLinesStyle": "Individual", "glyphGridOnlyWithAlternates": false, "glyphGridShowAllGlyphs": true, "glyphGridShowGlyphNames": true, "glyphGridShowMetricLines": true, "gridItemAlignments": [], "gridItemCases": [], "gridItemContents": [], "gridItemDirections": [], "gridItemFlows": [], "gridItemFontSizes": [], "gridItemForceUprightInVertical": [], "gridItemHorizontalLetterSpacings": [], "gridItemLineHeights": [], "gridItemOrientations": [], "gridItemParagraphSpacings": [], "gridItemVerticalCenter": [], "gridItemVerticalLetterSpacings": [], "gridLabelsAuto": true, "gridLabelShowAlignment": true, "gridLabelShowCase": true, "gridLabelShowDirection": true, "gridLabelShowFontSize": true, "gridLabelShowLetterSpacing": true, "gridLabelShowLineHeight": true, "gridLabelShowOrientation": true, "groupByFont": true, "horizontalLetterSpacing": 0, "horizontalLetterSpacings": [], "inlineStylingMode": "off", "language": "auto", "letterSpacing": 0, "letterSpacings": [], "lineHeight": 1.2, "lineHeights": [], "numerals": "default", "overflowToMultiplePages": true, "paragraphSpacing": 0, "perFontFeatures": [], "rowCount": 1, "