      "fontOverrides" : [

      ],
      "fontSize" : 9,
      "fontSizes" : [

      ],
      "forceUprightInVertical" : false,
      "glyphGridCombineStyles" : false,
      "glyphGridGroupAlternates" : false,
      "glyphGridHideEmptyGlyphs" : false,
      "glyphGridHideMissingGlyphs" : false,
      "glyphGridMetricLinesStyle" : "Individual",
      "glyphGridOnlyWithAlternates" : false,
      "glyphGridShowAllGlyphs" : false,
      "glyphGridShowGlyphNames" : true,
      "glyphGridShowMetricLines" : true,
